# Copy to .env.local for local work. On Vercel, set these in Project Settings > Environment Variables.
# Without the two Supabase values the app runs in demo mode locally (never in production).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: order emails through Resend
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_NOTIFY_EMAIL=

# Optional: lets you refresh every cached store page with POST /api/revalidate
REVALIDATE_SECRET=

# Optional, for previews only: route photo storage through this site. Leave empty in production.
NEXT_PUBLIC_STORAGE_PROXY=

# Optional: AI features (not built yet)
ANTHROPIC_API_KEY=
